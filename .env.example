# API server
# API_PORT is used by the local Go server. PORT is used by some hosting platforms.
API_PORT=8080
PORT=

# Database
# PostgreSQL connection string used by migrations, seed scripts, and the API.
DATABASE_URL=postgres://email_review:email_review@localhost:5433/email_review_tool?sslmode=disable

# Seed data
# Optional path to email seed files. Leave empty to use the default project path.
SEED_EMAILS_DIR=

# CORS / local development
# Frontend origin for local development when the API is called directly.
CORS_ORIGIN=http://localhost:5173

# OpenAI analysis
# OPENAI_API_KEY enables AI review features. AI_DEBUG_ENABLED exposes debug output only when true.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
AI_RESPONSE_LANGUAGE=English
AI_DEBUG_ENABLED=false

# Authentication
# Only users from AUTH_ALLOWED_DOMAIN can sign in. The bootstrap email is promoted to admin.
AUTH_ALLOWED_DOMAIN=alaio.com
AUTH_BOOTSTRAP_ADMIN_EMAIL=rubashkin@alaio.com
AUTH_APP_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false

# Invite-code login
# Prefer AUTH_INVITE_CODE_HASH in production. Generate it with:
# printf '%s' 'your-shared-code' | shasum -a 256
AUTH_INVITE_CODE=
AUTH_INVITE_CODE_HASH=

# Magic link delivery
# AUTH_FROM_EMAIL is used by SMTP and Resend. Keep AUTH_LOG_MAGIC_LINKS=true for local/dev fallback.
AUTH_FROM_EMAIL=Email Review Tool <login@alaio.com>
AUTH_LOG_MAGIC_LINKS=true

# Resend email delivery
# Used when RESEND_API_KEY is set.
RESEND_API_KEY=

# SMTP email delivery
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_TLS=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Web frontend
# Vite exposes only variables prefixed with VITE_ to browser code.
VITE_AUTH_ALLOWED_DOMAIN=alaio.com
