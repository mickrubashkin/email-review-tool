# API server
# API_PORT is used by the local Go server. PORT is used by some hosting platforms.
API_PORT=8080
PORT=

# Database
# PostgreSQL connection string used by migrations, seed scripts, and the API.
DATABASE_URL=postgres://email_review:email_review@localhost:5433/email_review_tool?sslmode=disable

# Seed data
# Optional path to email seed files. Leave empty to use the default project path.
SEED_EMAILS_DIR=
# Production containers skip seed by default. Set true only for intentional initial imports.
RUN_DB_SEED=false
# Destructive cleanup is opt-in. Keep false unless you intentionally want seed files to be source of truth.
SEED_DELETE_STALE_EMAILS=false

# CORS / local development
# Frontend origin for local development when the API is called directly.
CORS_ORIGIN=http://localhost:5173

# OpenAI analysis
# OPENAI_API_KEY enables AI review features. AI_DEBUG_ENABLED exposes debug output only when true.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
AI_RESPONSE_LANGUAGE=English
AI_DEBUG_ENABLED=false

# Authentication
# Only users from AUTH_ALLOWED_DOMAINS can sign in. The bootstrap email is promoted to admin.
# AUTH_ALLOWED_DOMAIN is still supported as a single-domain fallback.
# AUTH_ALLOWED_ORIGINS allows cookie-authenticated mutating requests from separate frontend origins.
AUTH_ALLOWED_DOMAINS=alaio.com,bitrix24.com,bitrix24.es,bitrix24.pl,bitrix24.com.br,bitrix24.de
AUTH_ALLOWED_DOMAIN=alaio.com
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_BOOTSTRAP_SUPER_ADMIN_EMAIL=rubashkin@alaio.com
AUTH_COOKIE_SECURE=false
# Local-only shortcut that creates a normal session without sending an OTP.
AUTH_DEV_LOGIN_ENABLED=true

# Email OTP delivery
# AUTH_FROM_EMAIL must be a sender address allowed by Resend.
# AUTH_REPLY_TO_EMAIL is optional and should be a real monitored mailbox.
# Keep AUTH_LOG_LOGIN_CODES=true for local/dev fallback. Set it to false in production.
AUTH_FROM_EMAIL=ReviewDesk <login@auth.rubashkin.xyz>
AUTH_REPLY_TO_EMAIL=
AUTH_LOG_LOGIN_CODES=true

# Resend email delivery
# Used when RESEND_API_KEY is set.
RESEND_API_KEY=

# Web frontend
# Vite exposes only variables prefixed with VITE_ to browser code.
VITE_AUTH_ALLOWED_DOMAINS=alaio.com,bitrix24.com,bitrix24.es,bitrix24.pl,bitrix24.com.br,bitrix24.de
VITE_AUTH_ALLOWED_DOMAIN=alaio.com
VITE_AUTH_DEV_LOGIN_ENABLED=true
